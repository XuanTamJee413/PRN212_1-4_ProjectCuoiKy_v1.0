<Window x:Class="ProjectCuoiKy.TestDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectCuoiKy"
        mc:Ignorable="d"
        Title="TestDetail" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <WrapPanel>
            <TextBlock x:Name="lblTestDetail" Text="Danh Sách Câu Hỏi:" Margin="10,20,0,0"/>
            <ComboBox x:Name="cbxTestList" Margin="10,15,10,10" SelectionChanged="cbxTestList_SelectionChanged" Width="300"></ComboBox>
        </WrapPanel>
        <DataGrid x:Name="dgvQuestionList" Margin="10,40,10,10" AutoGenerateColumns="False" CanUserAddRows="False" SelectedCellsChanged="dgvQuestionList_SelectedCellsChanged"
                  MaxHeight="700" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding QuestionId}" Width="25"/>
                <DataGridTextColumn Header="Question Text" Binding="{Binding QuestionText}" Width="5*"/>
                <DataGridTextColumn Header="Test Name" Binding="{Binding Test.TestName}" Width="*"/>
                <DataGridTextColumn Header="Correct Answer" Binding="{Binding CorrectAnswer}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,40,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Question Id" Width="100"/>
                <TextBox Name="txtQuestionId" Width="200" IsEnabled="False"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Quesstion Text" FontWeight="Bold" Width="100"/>
                <TextBox Name="txtQuestionText" FontWeight="Bold" Width="400" Height="100" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Label Content="Correct Answer" Foreground="Blue" Width="100"/>
                <TextBox Name="txtCorrectAnswer" FontWeight="Bold" Foreground="Blue" Width="400" Height="100" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <Label Content="Wrong Answer" Foreground="Red" Width="100"/>
                <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                    <TextBox Name="txtWrongAnswer1" Width="400" Height="100" Margin="0,5,0,0"/>
                    <TextBox Name="txtWrongAnswer2" Width="400" Height="100" Margin="0,5,0,0"/>
                    <TextBox Name="txtWrongAnswer3" Width="400" Height="100" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>


            <Grid Margin="0,10,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Name="btnInsertQuestion" Content="Insert" Width="100" Click="btnInsertQuestion_Click"/>
                <Button Grid.Column="1" Name="btnUpdateQuestion" Content="Update" Width="100" Click="btnUpdateQuestion_Click"/>
                <Button Grid.Column="2" Name="btnDeleteQuestion" Content="Delete" Width="100" Click="btnDeleteQuestion_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
