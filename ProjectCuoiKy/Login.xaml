<Window x:Class="ProjectCuoiKy.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectCuoiKy"
        mc:Ignorable="d"
        Title="Login" Height="400" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="225" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Column="1" Grid.Row="1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="1.5*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1.25*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Title -->
            <Label FontSize="20" FontWeight="Bold" Height="Auto" HorizontalAlignment="Center">Login</Label>

            <!-- Username and Password -->
            <Label Content="Username:" Grid.Row="1" Margin="25,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <TextBox Name="txbUsername" Grid.Row="2" Width="350" Height="Auto" HorizontalAlignment="Center"/>
            <Label Content="Password:" Grid.Row="3" Margin="25,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
            <PasswordBox Name="txbPassword" Grid.Row="4" Width="350" Height="Auto" HorizontalAlignment="Center"/>

            <!-- Login Button -->
            <Button x:Name="btnLogin" Content="Login" Grid.Row="5" Width="100" Height="Auto" HorizontalAlignment="Left" Margin="80,10,0,0" Click="btnLogin_Click"/>
            <Button x:Name="btnClear" Content="Clear" Grid.Row="5" Width="100" Height="Auto" HorizontalAlignment="Left" Margin="220,10,0,0" Click="btnClear_Click"/>

            <!-- Error Message -->
            <TextBlock x:Name="txbErrorMessage"   Grid.Row="6" Foreground="Red" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock x:Name="txbSuccessMessage"   Grid.Row="6" Foreground="Green" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0"/>
        </Grid>
    </Grid>
</Window>
