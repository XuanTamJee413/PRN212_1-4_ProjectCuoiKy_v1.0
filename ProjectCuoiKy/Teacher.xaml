<Window x:Class="ProjectCuoiKy.Teacher"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectCuoiKy"
        mc:Ignorable="d"
        Title="Teacher" Height="1000" Width="1080"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer>
        <Grid Background="LightGray">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.1*" />
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="0.1*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="10" />
                <RowDefinition Height="0.5*" MinHeight="75" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" MinHeight="180"/>
                <RowDefinition Height="20" />
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="20" />
                <RowDefinition Height="*" MinHeight="180"/>
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>

            <!--Khối thông tin người dùng-->
            <Grid Grid.Column="1" Grid.Row="1" Background="White">
                <WrapPanel>
                    <Label FontWeight="Bold" x:Name="lblUserName" Content="Giảng viên: " HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                </WrapPanel>
                <Button x:Name="btnLogout" Content="Logout" HorizontalAlignment="Right" Margin="0,10,10,0" VerticalAlignment="Top" Click="btnLogout_Click"/>
            </Grid>

            <!--Khối học phần hiện có-->
            <Grid Grid.Column="1" Grid.Row="3" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtCoursesLabel" Text="Danh Sách Course:" Margin="10,20,0,0"/>
                <DataGrid x:Name="dgCourses" Margin="10,40,10,10" AutoGenerateColumns="False" CanUserAddRows="False" SelectedCellsChanged="dgCourses_SelectedCellsChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding CourseId}" Width="25"/>
                        <DataGridTextColumn Header="Course Name" Binding="{Binding CourseName}" Width="5*"/>
                        <DataGridTextColumn Header="Created By" Binding="{Binding Creator.Username}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,40,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Course Id" Width="100"/>
                        <TextBox Name="txtCourseId" Width="200" IsEnabled="False"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Course Name" Width="100"/>
                        <TextBox Name="txtCourseName" Width="200"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Created By" Width="100"/>
                        <ComboBox x:Name="cbxCourseCreadtedBy" Width="200"/>
                    </StackPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Name="btnInsertCourse" Content="Insert" Width="70" Click="btnInsertCourse_Click"/>
                        <Button Grid.Column="2" Name="btnUpdateCourse" Content="Update" Width="70" Click="btnUpdateCourse_Click"/>
                        <Button Grid.Column="3" Name="btnDeleteCourse" Content="Delete" Width="70" Click="btnDeleteCourse_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!--Khối bài kiểm tra-->
            <Grid Grid.Column="1" Grid.Row="5" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <WrapPanel>
                    <TextBlock x:Name="txtQuizzesLabel" Text="Danh Sách Test:" Margin="10,20,0,0"/>
                    <ComboBox Name="cbxFilterTestByCourse" Height="20" Width="200" Margin="20,0" SelectionChanged="cbxFilterTestByCourse_SelectionChanged"></ComboBox>
                    <TextBox Name="tbxSearchTest" Width="200" Height="20" Margin="10,20" TextChanged="tbxSearchTest_TextChanged"/>
                    <Button Content="Search" Height="20" Name="btnSearchTest" Click="btnSearchTest_Click"></Button>
                </WrapPanel>
                <DataGrid x:Name="dgTests" Margin="10,40,10,10" AutoGenerateColumns="False" CanUserAddRows="False" SelectedCellsChanged="dgTests_SelectedCellsChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding TestId}" Width="25"/>
                        <DataGridTextColumn Header="Test Name" Binding="{Binding TestName}" Width="4*"/>
                        <DataGridTextColumn Header="Course" Binding="{Binding Course.CourseName}" Width="1.5*"/>
                        <DataGridTextColumn Header="Created" Binding="{Binding Creator.Username}" Width="1.5*"/>
                        <DataGridCheckBoxColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                        <DataGridTextColumn Header="Test Key" Binding="{Binding TestKey}" Width="2*"/>
                        <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate}" Width="*"/>
                        <DataGridTextColumn Header="End Date" Binding="{Binding EndDate}" Width="*"/>
                        <DataGridTextColumn Header="Due Time" Binding="{Binding DueTime}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,40,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Test Id" Width="100"/>
                        <TextBox Name="txtTestId" Width="200" IsEnabled="False"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Test Name" Width="100"/>
                        <TextBox Name="txtTestName" Width="200"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Course Name" Width="100"/>
                        <ComboBox x:Name="cbxCourseName" Width="200"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Created By" Width="100"/>
                        <ComboBox x:Name="cbxTestCreadtedBy" Width="200"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Status" Width="100"/>
                        <CheckBox Name="chkStatus" Content="Enable/Disable" Width="200" VerticalAlignment="Center" IsChecked="True"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Test Key" Width="100"/>
                        <TextBox Name="txtTestKey" Width="200"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Start Date" Width="100"/>
                        <DatePicker Name="dpkStartDate" Width="200"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="End Date" Width="100"/>
                        <DatePicker Name="dpkEndDate" Width="200"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Due Time" Width="100"/>
                        <TextBox Name="dpkDueTime" Width="200"/>
                    </StackPanel>
                    <Grid Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Name="btnViewTest" Content="EditQuestion" Width="75" Click="btnViewTest_Click"/>
                        <Button Grid.Column="1" Name="btnInsertTest" Content="Insert" Width="75" Click="btnInsertTest_Click"/>
                        <Button Grid.Column="2" Name="btnUpdateTest" Content="Update" Width="75" Click="btnUpdateTest_Click"/>
                        <Button Grid.Column="3" Name="btnDeleteTest" Content="Delete" Width="75" Click="btnDeleteTest_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!--Khối Điểm-->
            <Grid Grid.Column="1" Grid.Row="7" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="tblTestResult" Text="Danh Sách Test Result:" Margin="10,20,0,0"/>
                <DataGrid x:Name="dgTestResult" Margin="10,40,10,10" AutoGenerateColumns="False" CanUserAddRows="False" SelectedCellsChanged="dgTestResult_SelectedCellsChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ResultId}" Width="25"/>
                        <DataGridTextColumn Header="Test Id" Binding="{Binding TestId}" Width="*"/>
                        <DataGridTextColumn Header="Test Name" Binding="{Binding Test.TestName}" Width="*"/>
                        <DataGridTextColumn Header="Student Id" Binding="{Binding StudentId}" Width="*"/>
                        <DataGridTextColumn Header="Student Name" Binding="{Binding Student.Username}" Width="*"/>
                        <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="*"/>
                        <DataGridTextColumn Header="Done Time" Binding="{Binding CompletionTime}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,40,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Result Id" Width="100"/>
                        <Label Name="lblTestResultId" Width="200" Content="--"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Test Id" Width="100"/>
                        <Label Name="lblTestId" Width="200" Content="--"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Test Name" Width="100"/>
                        <Label Name="lblTestName" Width="200" Content="--"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Student Id" Width="100"/>
                        <Label x:Name="lblStudentId" Width="200" Content="--"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Student Name:" Width="100"/>
                        <Label Name="lblStudentName" Width="200" Content="--"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Score" Width="100"/>
                        <Label Name="lblScore" Width="200" Content="--" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Done Time" Width="100"/>
                        <DatePicker Name="dpkDoneTime" Width="200"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
