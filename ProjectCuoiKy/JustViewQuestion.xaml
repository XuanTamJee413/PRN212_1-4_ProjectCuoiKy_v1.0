<Window x:Class="ProjectCuoiKy.JustViewQuestion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectCuoiKy"
        mc:Ignorable="d"
        Title="JustViewQuestion" Height="720" Width="1080"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen">
    <Grid Background="LightGray">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.1*" />
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="0.1*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="10" />
            <RowDefinition Height="0.3*" MinHeight="75" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" MinHeight="200"/>
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>

        <!-- Hiển thị thông tin bài kiểm tra -->
        <Grid Grid.Column="1" Grid.Row="1" Background="White">
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock FontWeight="Bold" Text="Danh sách câu hỏi ôn tập :" Margin="0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <Label Content="Test Name:" Width="100"/>
                    <Label x:Name="lblTestName" Content="--" Width="200"/>
                </StackPanel>
                <Button Grid.Column="0" Name="btnClose" Content="Close" Width="100" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Click="btnClose_Click"/>
            </StackPanel>
        </Grid>

        <!-- Câu hỏi và câu trả lời -->
        <Grid Grid.Column="1" Grid.Row="3" Background="White">
            <TextBlock Text="Questions:" Margin="10,20,0,0"/>
            <ListBox x:Name="questionsList" Margin="10,40,10,10" SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Name="tblQuestionText" Text="{Binding QuestionText}" FontWeight="Bold"/>

                            <RadioButton Content="{Binding A}" Tag="A" GroupName="{Binding QuestionId}" Margin="5,0"/>
                            <RadioButton Content="{Binding B}" Tag="B" GroupName="{Binding QuestionId}" Margin="5,0" />
                            <RadioButton Content="{Binding C}" Tag="C" GroupName="{Binding QuestionId}" Margin="5,0"/>
                            <RadioButton Content="{Binding D}" Tag="D" GroupName="{Binding QuestionId}" Margin="5,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
