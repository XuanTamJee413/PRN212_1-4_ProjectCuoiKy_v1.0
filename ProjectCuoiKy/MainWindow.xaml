<Window x:Class="ProjectCuoiKy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectCuoiKy"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <ScrollViewer>
        <Grid Background="LightGray">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.1*" />
                <ColumnDefinition Width="2*" MaxWidth="1080"/>
                <ColumnDefinition Width="0.1*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="10" />
                <RowDefinition Height="0.5*" MinHeight="75" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="20" />
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>

             <!--Khối thông tin người dùng và các nút--> 
            <Grid Grid.Column="1" Grid.Row="1" Background="White">
                <Label x:Name="lblUserName" Content="Bạn chưa đăng nhập" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                <Button x:Name="btnLogin" Content="Login" Width="70"  HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Click="btnLogin_Click"/>
                <Button x:Name="btnLoginAsAdmin" Content="Admin" Width="70"  HorizontalAlignment="Right" Margin="0,0,100,10" VerticalAlignment="Bottom" Click="btnLoginAsAdmin_Click"/>
                <Button x:Name="btnLoginAsTeacher" Content="Teacher" Width="70"  HorizontalAlignment="Right" Margin="0,0,200,10" VerticalAlignment="Bottom" Click="btnLoginAsTeacher_Click"/>
                <Button x:Name="btnLoginAsStudent" Content="Student" Width="70"  HorizontalAlignment="Right" Margin="0,0,300,10" VerticalAlignment="Bottom" Click="btnLoginAsStudent_Click"/>
            </Grid>

             <!--Khối học phần hiện có--> 
            <Grid Grid.Column="1" Grid.Row="3" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtCoursesLabel" Text="Danh Sách Course:" Margin="10,20,0,0"/>
                <DataGrid x:Name="dgCourses" Margin="10,40,10,10" AutoGenerateColumns="False" CanUserAddRows="False"    >
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding CourseId}" Width="25"/>
                        <DataGridTextColumn Header="Course Name" Binding="{Binding CourseName}" Width="5*"/>
                        <DataGridTextColumn Header="Created By" Binding="{Binding Creator.Username}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,40,0,0">
                    
                </StackPanel>
            </Grid>

            <!--Khối bài kiểm tra-->
            <Grid Grid.Column="1" Grid.Row="5" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtTestLabel" Text="Danh Sách Quiz Ôn Tập:" Margin="10,20,0,0"/>
                <DataGrid x:Name="dgTests" Margin="10,40,10,10" AutoGenerateColumns="False" CanUserAddRows="False" SelectedCellsChanged="dgTests_SelectedCellsChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding TestId}" Width="25"/>
                        <DataGridTextColumn Header="Test Name" Binding="{Binding TestName}" Width="4*"/>
                        <DataGridTextColumn Header="Course" Binding="{Binding Course.CourseName}" Width="1.5*"/>
                        <DataGridTextColumn Header="Created" Binding="{Binding Creator.Username}" Width="1.5*"/>
                        <DataGridCheckBoxColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,40,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Test Id" Width="100"/>
                        <TextBox Name="txtTestId" Width="200" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Test Name" Width="100"/>
                        <TextBox Name="txtTestName" Width="200" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Course Name" Width="100"/>
                        <TextBox x:Name="txtCourseName" Width="200" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Created By" Width="100" />
                        <TextBox x:Name="txtTestCreadtedBy" Width="200" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Status" Width="100"/>
                        <Label Name="lblStatus" Content="--" Width="200"/>
                    </StackPanel>
                    <Grid Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Name="btnViewQuestion" Content="Ôn Tập Quiz" Width="150" Click="btnViewQuestion_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
