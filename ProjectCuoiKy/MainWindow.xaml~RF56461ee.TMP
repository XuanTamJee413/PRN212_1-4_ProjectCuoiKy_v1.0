<Window x:Class="ProjectCuoiKy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectCuoiKy"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1080"
        Loaded="Window_Loaded">
    <ScrollViewer>
        <Grid Background="LightGray">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.1*" />
                <ColumnDefinition Width="2*" MaxWidth="1000"/>
                <ColumnDefinition Width="0.1*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="10" />
                <RowDefinition Height="0.5*" MinHeight="75" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="20" />
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>

             <!--Khối thông tin người dùng và các nút--> 
            <Grid Grid.Column="1" Grid.Row="1" Background="White">
                <Label x:Name="lblUserName" Content="Bạn chưa đăng nhập" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                <Button x:Name="btnLogin" Content="Đăng Nhập" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Click="LoginButton_Click"/>
            </Grid>

             <!--Khối học phần hiện có--> 
            <Grid Grid.Column="1" Grid.Row="3" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtCoursesLabel" Text="Danh Sách Course:" Margin="10,20,0,0"/>
                <Button Name="btnAddASet" Margin="0,15,10,0" HorizontalAlignment="Right" VerticalAlignment="Top" >Thêm học phần</Button>
                <DataGrid x:Name="dgCourses" Margin="10,40,10,10" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="dgCourses_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding CourseId}" Width="25"/>
                        <DataGridTextColumn Header="Course Name" Binding="{Binding CourseName}" Width="5*"/>
                        <DataGridTextColumn Header="Created By" Binding="{Binding Creator.Username}" Width="*"/>
                        <DataGridTemplateColumn Header="Details">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Name="btnSetDetail" Content="Xem" Click="btnSetDetail_Click"  Tag="{Binding CourseId}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Id" Width="60"/>
                        <TextBox Name="txtId" Width="200"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Name" Width="60"/>
                        <TextBox Name="txtName" Width="200"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Gender" Width="60"/>
                        <CheckBox Name="chkGender" Content="Male/Female" Width="200" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Departmenttt" Width="60"/>
                        <ComboBox x:Name="cbxDepart" Width="200"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="DOB" Width="60"/>
                        <DatePicker Name="dpkDob" Width="200" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="GPA" Width="60"/>
                        <TextBox Name="txtGpa" Width="200"/>
                    </StackPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Name="btnInsertCourse" Content="Insert" Width="50" Click="btnInsertCourse_Click"/>
                        <Button Grid.Column="1" Name="btnUpdateCourse" Content="Update" Width="50" Click="btnUpdateCourse_Click"/>
                        <Button Grid.Column="2" Name="btnDeleteCourse" Content="Delete" Width="50" Click="btnDeleteCourse_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>

             <!--Khối bài kiểm tra--> 
            <Grid Grid.Column="1" Grid.Row="5" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtQuizzesLabel" Text="Danh Sách Test:" Margin="10,20,0,0"/>
                <Button Name="btnAddATest" Margin="0,15,10,0" HorizontalAlignment="Right" VerticalAlignment="Top" >Thêm bài kiểm tra</Button>
                <DataGrid x:Name="dgQuizzes" Margin="10,40,10,10" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="dgQuizzes_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding TestId}" Width="25"/>
                        <DataGridTextColumn Header="Test Name" Binding="{Binding Course.CourseName}" Width="5*"/>
                        <DataGridTextColumn Header="Created By" Binding="{Binding Creator.Username }" Width="*"/>
                        <DataGridTemplateColumn Header="Details">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Name="btnQuizDetail" Content="Xem" Click="btnQuizDetail_Click" Tag="{Binding CourseId}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                
                <Grid Grid.Column="1">
                    
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
